{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.cjs",
    "test/**/*.js",
    "tools/**/*.js",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "coverage", "test/consumer"]
}
