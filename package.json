{
  "name": "@zang3th/md-libs",
  "version": "0.4.0",
  "description": "Shared, tested application core for MD_Manager and MD_Calendar.",
  "license": "MIT",
  "author": "Tim Krueger (https://github.com/Zang3th)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zang3th/MD_Libs.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./platform": {
      "types": "./types/platform/index.d.ts",
      "default": "./src/platform/index.js"
    },
    "./ui": {
      "types": "./types/ui/index.d.ts",
      "default": "./src/ui/index.js"
    },
    "./harness/build": {
      "types": "./types/harness/build.d.cts",
      "default": "./src/harness/build.cjs"
    },
    "./harness/testing": {
      "types": "./types/harness/testing.d.cts",
      "default": "./src/harness/testing.cjs"
    },
    "./harness/checks": {
      "types": "./types/harness/checks.d.cts",
      "default": "./src/harness/checks.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "config",
    "types"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check:types": "tsc -p jsconfig.json && node tools/declarations.js --check && node tools/check-consumer.js",
    "check:lint": "eslint . --max-warnings=0",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"test/**/*.test.js\"",
    "verify": "npm run check:types && npm run check:lint && npm test",
    "stats": "node tools/project-stats.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
